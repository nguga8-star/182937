  fetch('/cmd?spd=' + val).catch(()=>{});
}

function toggleMode(){
  let next = (currentMode === "AUTO") ? "MANUAL" : "AUTO";
  fetch('/cmd?mode=' + next).then(r=>r.json()).then(d=>applyTelemetry(d)).catch(()=>{});
}

function sendCmd(dir){
  if(currentMode === "AUTO") currentMode = "MANUAL";
  fetch('/cmd?mode=MANUAL&dir=' + dir).catch(()=>{});
}

function clearMap(){
  pathPoints = [{x:0, y:0}];
  fetch('/cmd?reset_map=1').catch(()=>{});
  drawTrajectory();
}

function drawTrajectory(){
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  const cx = canvas.width / 2;
  const cy = canvas.height / 2;

  // Vẽ lưới tọa độ
  ctx.strokeStyle = '#1e293b';
  ctx.lineWidth = 1;
  for(let x=0; x<canvas.width; x+=30){ ctx.beginPath(); ctx.moveTo(x,0); ctx.lineTo(x,canvas.height); ctx.stroke(); }
  for(let y=0; y<canvas.height; y+=30){ ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(canvas.width,y); ctx.stroke(); }

  if(pathPoints.length === 0) return;

  // Tự động co giãn tỷ lệ (Auto-scale) để quỹ đạo luôn nằm gọn trong màn hình
  let maxCoord = 60;
  pathPoints.forEach(p => {
    maxCoord = Math.max(maxCoord, Math.abs(p.x), Math.abs(p.y));
  });
  let scale = (Math.min(cx, cy) - 22) / maxCoord;

  // Vẽ đường quỹ đạo xe đã đi
  ctx.strokeStyle = '#38bdf8';
  ctx.lineWidth = 2.5;
  ctx.beginPath();
  pathPoints.forEach((p, idx) => {
    let sx = cx + p.x * scale;
    let sy = cy - p.y * scale;
    if(idx === 0) ctx.moveTo(sx, sy);
    else ctx.lineTo(sx, sy);
  });
  ctx.stroke();

  // Điểm xuất phát
  ctx.fillStyle = '#94a3b8';
  ctx.beginPath();
  ctx.arc(cx, cy, 4, 0, Math.PI*2);
  ctx.fill();

  // Vẽ vị trí và hướng mũi xe hiện tại
  let last = pathPoints[pathPoints.length - 1];
  let rx = cx + last.x * scale;
  let ry = cy - last.y * scale;
  let rad = -currentYaw * Math.PI / 180.0;

  ctx.save();
  ctx.translate(rx, ry);
  ctx.rotate(rad);
  ctx.fillStyle = '#22c55e';
  ctx.beginPath();
  ctx.moveTo(0, -9);
  ctx.lineTo(-6, 7);
  ctx.lineTo(6, 7);
  ctx.closePath();
  ctx.fill();
  ctx.restore();
}

