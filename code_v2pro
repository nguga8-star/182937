# ==============================================================================
# 3. LỚP ĐIỀU KHIỂN ĐỘNG CƠ L298N
# ==============================================================================
class MotorDriver:
    def __init__(self):
        self.in1 = Pin(Config.IN1_PIN, Pin.OUT, value=0)
        self.in2 = Pin(Config.IN2_PIN, Pin.OUT, value=0)
        self.in3 = Pin(Config.IN3_PIN, Pin.OUT, value=0)
        self.in4 = Pin(Config.IN4_PIN, Pin.OUT, value=0)

        self.ena = PWM(Pin(Config.ENA_PIN), freq=1000)
        self.enb = PWM(Pin(Config.ENB_PIN), freq=1000)

        self.curr_left = 0.0
        self.curr_right = 0.0
        self.stop()

    def _write_pwm(self, pwm_obj, speed_val):
        speed_val = max(0.0, min(Config.PWM_SCALE, float(speed_val)))
        if hasattr(pwm_obj, "duty_u16"):
            pwm_obj.duty_u16(int(speed_val * 65535 / Config.PWM_SCALE))
        else:
            pwm_obj.duty(int(speed_val * 1023 / Config.PWM_SCALE))

    def set_motors(self, left_speed, right_speed):
        self.curr_left = max(-Config.PWM_SCALE, min(Config.PWM_SCALE, float(left_speed)))
        self.curr_right = max(-Config.PWM_SCALE, min(Config.PWM_SCALE, float(right_speed)))

        # Bánh Trái (Motor A)
        if self.curr_left > 1.0:
            self.in1.value(1)
            self.in2.value(0)
            self._write_pwm(self.ena, self.curr_left)
        elif self.curr_left < -1.0:
            self.in1.value(0)
            self.in2.value(1)
            self._write_pwm(self.ena, -self.curr_left)
        else:
            self.in1.value(0)
            self.in2.value(0)
            self._write_pwm(self.ena, 0)

        # Bánh Phải (Motor B)
        if self.curr_right > 1.0:
            self.in3.value(1)
            self.in4.value(0)
            self._write_pwm(self.enb, self.curr_right)
        elif self.curr_right < -1.0:
            self.in3.value(0)
            self.in4.value(1)
            self._write_pwm(self.enb, -self.curr_right)
        else:
            self.in3.value(0)
            self.in4.value(0)
            self._write_pwm(self.enb, 0)

    def move_smooth(self, target_left, target_right, max_step=15.0):
        diff_l = target_left - self.curr_left
        diff_r = target_right - self.curr_right

        new_l = self.curr_left + math.copysign(max_step, diff_l) if abs(diff_l) > max_step else target_left
        new_r = self.curr_right + math.copysign(max_step, diff_r) if abs(diff_r) > max_step else target_right
        self.set_motors(new_l, new_r)

    def brake(self):
        self.in1.value(1)
        self.in2.value(1)
        self.in3.value(1)
        self.in4.value(1)
        self._write_pwm(self.ena, Config.PWM_SCALE)
        self._write_pwm(self.enb, Config.PWM_SCALE)
        time.sleep_ms(70)
        self.stop()

    def stop(self):
        self.in1.value(0)
        self.in2.value(0)
        self.in3.value(0)
        self.in4.value(0)
        self._write_pwm(self.ena, 0)
        self._write_pwm(self.enb, 0)
        self.curr_left = 0.0
        self.curr_right = 0.0


