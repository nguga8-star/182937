# 4. LỚP CẢM BIẾN SIÊU ÂM SRF05 & SERVO QUÉT GÓC
# ==============================================================================
class UltrasonicSRF05:
    def __init__(self):
        self.trig = Pin(Config.TRIG_PIN, Pin.OUT, value=0)
        self.echo = Pin(Config.ECHO_PIN, Pin.IN)

    def _read_once(self):
        self.trig.value(0)
        time.sleep_us(2)
        self.trig.value(1)
        time.sleep_us(10)
        self.trig.value(0)
        try:
            pulse_time = time_pulse_us(self.echo, 1, 22000)
            if pulse_time < 0:
                return 250.0
            distance = (pulse_time * 0.0343) / 2.0
            return min(250.0, max(2.0, distance))
        except OSError:
            return 250.0

    def get_distance(self, samples=3):
        if samples <= 1:
            return self._read_once()
        readings = []
        for _ in range(samples):
            readings.append(self._read_once())
            time.sleep_ms(4)
        readings.sort()
        return readings[len(readings) // 2]


class RadarServo:
    def __init__(self):
        self.pwm = PWM(Pin(Config.SERVO_PIN), freq=50)
        self.current_angle = Config.SERVO_CENTER
        self.set_angle(Config.SERVO_CENTER, settle_ms=200)

    def _write_angle_pwm(self, angle):
        angle = max(10, min(170, int(angle)))
        pulse_us = 500 + (angle * 2000) // 180
        if hasattr(self.pwm, "duty_ns"):
            self.pwm.duty_ns(pulse_us * 1000)
        elif hasattr(self.pwm, "duty_u16"):
            self.pwm.duty_u16(int(pulse_us * 65535 // 20000))
        else:
            self.pwm.duty(int(pulse_us * 1023 // 20000))

    def set_angle(self, target_angle, settle_ms=135):
        self._write_angle_pwm(target_angle)
        self.current_angle = target_angle
        if settle_ms > 0:
            time.sleep_ms(settle_ms)

    def center(self):
        if self.current_angle != Config.SERVO_CENTER:
            self.set_angle(Config.SERVO_CENTER, settle_ms=135)


